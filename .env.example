# Solo se usan si no hay configuración guardada desde la app (Ajustes de correo).
# SMTP_HOST y SMTP_PORT son opcionales: por defecto smtp.gmail.com:587
# (puerto 465 usa SSL directo, cualquier otro usa STARTTLS).
SMTP_USER=usuario@centroeducativo.es
SMTP_PASS=tu_password_o_app_token
DB_DIR=/app/data
